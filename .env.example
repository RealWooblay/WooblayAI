# ─────────────────────────────────────────────────────────────────────────────
# Wooblay Gate — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://wooblay:wooblay_dev@localhost:5432/wooblay_dev

# Server port
PORT=4800

# Ed25519 signing keys (hex-encoded)
# Generate with: node -e "const {generateKeyPairSync} = require('crypto'); const kp = generateKeyPairSync('ed25519'); console.log('PRIVATE:', kp.privateKey.export({type:'pkcs8',format:'der'}).toString('hex')); console.log('PUBLIC:', kp.publicKey.export({type:'spki',format:'der'}).toString('hex'));"
WOOBLAY_SERVER_PRIVATE_KEY=
WOOBLAY_SERVER_PUBLIC_KEY=

# Environment
NODE_ENV=development

# ── Platform Mode (SaaS) ────────────────────────────────────────────────────
# Set to "true" to run as the central platform (user accounts, billing, etc.)
# Leave unset or "false" for per-instance runtime mode.
PLATFORM_MODE=false

# Clerk auth (required when PLATFORM_MODE=true)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Frontend URL (for CORS and redirects)
WOOBLAY_DASHBOARD_URL=http://localhost:5173

# Full Platform unlock password (we give this to select customers; default WOBBLE in dev only)
FULL_PLATFORM_UNLOCK_PASSWORD=WOBBLE

# ── AI Supervisor (OpenAI) ──────────────────────────────────────────────────
# Powers intelligent agent behavior analysis, threat detection, and contribution evaluation.
# Without this key, Wooblay uses rule-based detection only. With it, you get:
#   - AI threat assessment on every tool call
#   - Behavioral pattern analysis (escalation, exfiltration, evasion)
#   - Contribution quality scoring and session summaries
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Credential Vault ─────────────────────────────────────────────────────────
# AES-256-GCM master key for envelope encryption of stored credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=

# ── Instance Management ──────────────────────────────────────────────────────
# Directory where agent instance data is stored (Docker volumes, configs)
INSTANCES_DIR=./data/instances

# Internal Gate URL used by MCP proxy containers on the Docker network
GATE_INTERNAL_URL=http://gate:4800

# ── Notifications ────────────────────────────────────────────────────────────
# Telegram Bot API (recommended — get a token from @BotFather)
TELEGRAM_BOT_TOKEN=

# SMTP for email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@wooblay.com

# WhatsApp Cloud API via Meta (optional — requires Meta Business verification)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Public URL for notification action links (must be reachable from the internet)
GATE_PUBLIC_URL=https://gate.wooblay.com

# ── MCP Proxy (apps/mcp-proxy) ───────────────────────────────────────────────
# Authentication token for MCP proxy → Gate communication
GATEWAY_TOKEN=

# Port for the MCP proxy SSE server (default: 3100)
MCP_PROXY_PORT=3100

# Instance ID for this proxy deployment (from the Wooblay dashboard)
INSTANCE_ID=

# Gate URL the proxy connects to (defaults to http://localhost:4800)
GATE_URL=http://localhost:4800

# MCP server configuration — base64-encoded JSON array of upstream servers
# Example: echo '[{"name":"github","command":"npx","args":["@modelcontextprotocol/server-github"]}]' | base64
MCP_SERVERS_JSON_B64=

# ── Frontend (apps/ui) ──────────────────────────────────────────────────────
# Vite environment variables (prefix with VITE_)
VITE_API_URL=http://localhost:4800
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
