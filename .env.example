# Database
DATABASE_URL=postgresql://wooblay:wooblay_dev@localhost:5432/wooblay_dev

# Gate Server
PORT=4800

# Signing Keys (hex-encoded ed25519 DER)
# Generate with: wooblay init
WOOBLAY_SERVER_PRIVATE_KEY=
WOOBLAY_SERVER_PUBLIC_KEY=

# Tool Host Identity
WOOBLAY_TOOLHOST_PRIVATE_KEY=
WOOBLAY_TOOLHOST_PUBLIC_KEY=

# Gate URL (for Tool Host)
WOOBLAY_GATE_URL=http://localhost:4800
