{
  "name": "@wooblay/gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b && cp -r prisma dist/",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@clerk/fastify": "^2.6.21",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^6.3.0",
    "@wooblay/crypto": "workspace:*",
    "@wooblay/schemas": "workspace:*",
    "@wooblay/types": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "nodemailer": "^8.0.1",
    "openai": "^6.21.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11",
    "@types/ws": "^8.5.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}